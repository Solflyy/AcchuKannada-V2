{
  "quotes": [
    {
      "id": "q01",
      "quote": "ಹೊಸ ದಿನ, ಹೊಸ ಆಶೆ, ಹೊಸ ಶಕ್ತಿ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೇರಣೆ"
    },
    {
      "id": "q02",
      "quote": "ಸೋಲು ಅಂತ್ಯವಲ್ಲ, ಅದು ಪ್ರಾರಂಭ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೇರಣೆ"
    },
    {
      "id": "q03",
      "quote": "ಕನಸು ಕಾಣಿ, ಗೆಲ್ಲಿ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೇರಣೆ"
    },
    {
      "id": "q04",
      "quote": "ಜೀವನ ಒಂದು ಪ್ರಯಾಣ, ಆನಂದಿಸಿ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಜೀವನ"
    },
    {
      "id": "q05",
      "quote": "ಮನಸ್ಸಿದ್ದರೆ ಮಾರ್ಗ ಇದ್ದೇ ಇರುತ್ತದೆ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೇರಣೆ"
    },
    {
      "id": "q06",
      "quote": "ಸ್ನೇಹ ಜೀವನದ ಹಣ್ಣು.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಸ್ನೇಹ"
    },
    {
      "id": "q07",
      "quote": "ಪ್ರೀತಿ ಕೊಡಿ, ಪ್ರೀತಿ ಪಡೆಯಿರಿ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೀತಿ"
    },
    {
      "id": "q08",
      "quote": "ಅಮ್ಮನ ಪ್ರೀತಿ ದೇವರ ಕೊಡುಗೆ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಕುಟುಂಬ"
    },
    {
      "id": "q09",
      "quote": "ತಾಳ್ಮೆ ವಿಜಯದ ಬೀಜ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೇರಣೆ"
    },
    {
      "id": "q10",
      "quote": "ನಗು ಅತ್ಯುತ್ತಮ ಔಷಧ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಜೀವನ"
    },
    {
      "id": "q11",
      "quote": "ಸಂತೋಷ ನಮ್ಮ ಆಯ್ಕೆ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಜೀವನ"
    },
    {
      "id": "q12",
      "quote": "ಪ್ರತಿ ಮುಂಜಾನೆ ಹೊಸ ಅವಕಾಶ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೇರಣೆ"
    },
    {
      "id": "q13",
      "quote": "ಓದು ಜ್ಞಾನದ ದಾರಿ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಜ್ಞಾನ"
    },
    {
      "id": "q14",
      "quote": "ನಾಳೆಗೆ ಕಾಯದೆ, ಇಂದೇ ಮಾಡಿ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೇರಣೆ"
    },
    {
      "id": "q15",
      "quote": "ದಯೆ ತೋರಿ, ದೇವರಾಗಿ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಮೌಲ್ಯಗಳು"
    },
    {
      "id": "q16",
      "quote": "ಕನ್ನಡ ನಮ್ಮ ತಾಯ್ನುಡಿ, ಹೆಮ್ಮೆಯ ಭಾಷೆ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಕನ್ನಡ"
    },
    {
      "id": "q17",
      "quote": "ಶ್ರಮ ಇದ್ದಲ್ಲಿ ಫಲ ಇದ್ದೇ ಇದೆ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೇರಣೆ"
    },
    {
      "id": "q18",
      "quote": "ವಿಶ್ವಾಸ ಪ್ರೇಮದ ಅಡಿಪಾಯ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೀತಿ"
    },
    {
      "id": "q19",
      "quote": "ಸ್ವಸ್ಥ ಮನಸ್ಸು, ಸ್ವಸ್ಥ ದೇಹ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಆರೋಗ್ಯ"
    },
    {
      "id": "q20",
      "quote": "ಜೀವನ ಚಿಕ್ಕದು, ಪ್ರೀತಿ ದೊಡ್ಡದು.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೀತಿ"
    },
    {
      "id": "q21",
      "quote": "ಒಳ್ಳೆಯ ಮಾತು ಹೃದಯ ಗೆಲ್ಲುತ್ತದೆ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಮೌಲ್ಯಗಳು"
    },
    {
      "id": "q22",
      "quote": "ಕನ್ನಡ ನಾಡು ನಮ್ಮ ಅಭಿಮಾನ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಕನ್ನಡ"
    },
    {
      "id": "q23",
      "quote": "ನಂಬಿಕೆ ಮತ್ತು ಶ್ರಮ — ಯಶಸ್ಸಿನ ರಹಸ್ಯ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೇರಣೆ"
    },
    {
      "id": "q24",
      "quote": "ಇಂದಿನ ಕಷ್ಟ ನಾಳಿನ ಶಕ್ತಿ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೇರಣೆ"
    },
    {
      "id": "q25",
      "quote": "ಉತ್ತಮ ಸ್ನೇಹಿತ ಅಮೂಲ್ಯ ಸಂಪತ್ತು.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಸ್ನೇಹ"
    },
    {
      "id": "q26",
      "quote": "ತಪ್ಪುಗಳಿಂದ ಕಲಿ, ಮುಂದೆ ನಡೆ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಪ್ರೇರಣೆ"
    },
    {
      "id": "q27",
      "quote": "ಮಕ್ಕಳ ನಗು ದೇವರ ಅನುಗ್ರಹ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಕುಟುಂಬ"
    },
    {
      "id": "q28",
      "quote": "ಧ್ಯಾನ ಮನಸ್ಸಿನ ಔಷಧ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಆರೋಗ್ಯ"
    },
    {
      "id": "q29",
      "quote": "ಕ್ಷಮೆ ಮಹಾನ್ ಶಕ್ತಿ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಮೌಲ್ಯಗಳು"
    },
    {
      "id": "q30",
      "quote": "ಶಿಕ್ಷಣ ಬೆಳಕಿನ ದಾರಿ.",
      "author": "— ಅಜ್ಞಾತ",
      "category": "ಜ್ಞಾನ"
    }
  ],
  "categories": ["ಎಲ್ಲಾ", "ಪ್ರೇರಣೆ", "ಪ್ರೀತಿ", "ಜೀವನ", "ಸ್ನೇಹ", "ಕುಟುಂಬ", "ಕನ್ನಡ", "ಜ್ಞಾನ", "ಮೌಲ್ಯಗಳು", "ಆರೋಗ್ಯ"]
}
